# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# API keys and secrets - NEVER commit these!
b4m_api.md
.env
*.key
*_api_key*
*_secret*

# Robot configuration with WiFi credentials
config_robot.py

# Python byte code
*.pyc
__pycache__/

# ROS build directories
build/
devel/
install/
log/

# Colcon build directories
build/
install/
log/

# Eclipse project files
.cproject
.project
.pydevproject
.settings/

# QtCreator project files
CMakeLists.txt.user
*.creator
*.creator.user
*.files
*.includes
*.config

# Visual Studio Code
.vscode/

# Temporary files
*~
*.swp
*.swo

# Backup files
*.bak
*.backup

# ROS bag files
*.bag
*.bag.active

# ROS transform frame visualization files
frames*.gv
frames*.pdf

# Generated message and service files
**/msg/_*.py
**/srv/_*.py

# Ignore generated docs
*/docs/html
*/docs/latex

# Ignore specific packages with their own git repositories
robot_localization/

# Workspace directories (source code is documented in WORKSPACE_README.md)
# Only track the structure, not the contents
gmapping_ws/*
!gmapping_ws/src/
gmapping_ws/src/*
!gmapping_ws/src/.gitkeep

imu_ws/*
!imu_ws/src/
imu_ws/src/*
!imu_ws/src/.gitkeep

uros_ws/*
!uros_ws/src/
uros_ws/src/*
!uros_ws/src/.gitkeep
b4m_waypoint_nav/logs/waypoint_nav.log

# Ignore all .pgm and .yaml files in yahboomcar_nav/maps except for yahboom_map.pgm and yahboom_map.yaml
yahboomcar_nav/maps/*.pgm
yahboomcar_nav/maps/*.yaml
!yahboomcar_nav/maps/yahboom_map.pgm
!yahboomcar_nav/maps/yahboom_map.yaml


# Runtime logs from launch script
logs/

# Regression test screenshots and results (but keep reference screenshots)
regression/screenshots/*.png
regression/screenshots/*.json
!regression/reference_screenshots_simulation/
!regression/reference_screenshots_real/

# HA_converse speech-to-text output files
conversation.txt
prompts/

# Unused/temporary files directory
unused/
