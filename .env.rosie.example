# ROSIE Conversational AI System Configuration
#
# IMPORTANT: Set these required variables in ~/.bashrc:
#   - B4M_API_KEY=your_api_key_here
#   - B4M_OLLAMA_CONVERSATION_ID=your_conversation_id_here
#   - PIPER_MODEL_PATH=/path/to/your/piper/model.onnx
#
# Alternatively, you can uncomment and set them directly in this file
# (but .bashrc is preferred for system-wide availability)

# bike4mind API Configuration (REQUIRED for intelligent background analysis)
# Uncomment and set if not in .bashrc:
# B4M_API_KEY=your_bike4mind_api_key_here
# B4M_OLLAMA_CONVERSATION_ID=your_conversation_id_here

# bike4mind User ID (OPTIONAL - has default value)
# B4M_USER_ID=65563f622213b120cd1d9592

# Whisper Configuration
WHISPER_MODEL=base  # Options: tiny, base, small, medium, large
WHISPER_CHUNK_DURATION=5  # seconds to record per chunk (longer = fewer cut-off sentences)

# Ollama Configuration
# Recommended: llama3.1:8b for superior natural conversation quality (best for 8GB+ VRAM)
# Alternative: qwen2.5:1.5b (good balance, less natural)
# Minimum: qwen2.5:0.5b (fastest but basic responses)
# Also good: qwen2.5:3b, qwen2.5:7b (requires more VRAM)
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=100

# Piper Configuration (PIPER_MODEL_PATH should be set in .bashrc)
# PIPER_MODEL_PATH is already set in .bashrc
# PIPER_CONFIG_PATH is already set in .bashrc

# File Paths (defaults to /tmp - change if needed)
LISTEN_FILE=/tmp/listen.txt
SUMMARY_FILE=/tmp/summary.txt
SPEAK_FILE=/tmp/speak.txt

# Conversation Pruning (to prevent unbounded growth)
MAX_WORDS=100  # Keep only last 100 words in listen.txt

# Debug Mode (set to 1 to enable verbose logging)
DEBUG=0
