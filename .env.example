# Bike4Mind API Configuration
# Copy this file to .env and replace with your actual API key
# NEVER commit the .env file to version control!

# Get your API key from https://app.bike4mind.com
B4M_API_KEY=your_api_key_here

# API Endpoint (usually doesn't need to be changed)
B4M_API_URL=https://app.bike4mind.com/api