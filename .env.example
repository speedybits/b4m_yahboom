# Bike4Mind API Configuration
# Copy this file to .env and replace with your actual API key
# NEVER commit the .env file to version control!

# Get your API key from https://app.bike4mind.com
B4M_API_KEY=your_api_key_here

# API Endpoint (usually doesn't need to be changed)
B4M_API_URL=https://app.bike4mind.com/api

# Robot WiFi Configuration
# These are used by config_robot.py to set up the robot's network
ROBOT_WIFI_SSID=your_wifi_ssid_here
ROBOT_WIFI_PASSWORD=your_wifi_password_here

# Agent Connection Configuration
# Option 1: Use a fixed IP address (traditional method)
ROBOT_AGENT_IP=192.168.68.105

# Option 2: Use mDNS hostname (recommended for dynamic IP environments)
# Uncomment and set this to use hostname resolution instead of fixed IP
# ROBOT_AGENT_HOSTNAME=robot.local
# Note: Requires mDNS support (avahi-daemon on Linux)
# If both ROBOT_AGENT_HOSTNAME and ROBOT_AGENT_IP are set, hostname takes precedence

ROBOT_AGENT_PORT=8090
